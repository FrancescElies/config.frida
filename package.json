{
  "name": "scripts.frida-agent",
  "version": "1.0.0",
  "description": "Frida agent written in TypeScript",
  "private": true,
  "main": "agent/index.ts",
  "type": "module",
  "scripts": {
    "prepare": "npm run build",
    "build": "frida-compile agent/index.ts -o _agent.js -c",
    "watch": "frida-compile agent/index.ts -o _agent.js -w"
  },
  "devDependencies": {
    "@types/frida-gum": "^19.0.0",
    "@types/node": "^18.14.0",
    "frida-compile": "^19.0.5",
    "typescript": "^5.3.0",
    "ts-node": "^10.9.2"
  },
  "dependencies": {
    "frida": "^17.17.0",
    "tree-sitter": "^0.21.1",
    "tree-sitter-cpp": "^0.23.4"
  },
  "optionalDependencies": {
    "libclang": "^0.4.0"
  },
  "resolutions": {
    "tree-sitter": "0.21.1"
  },
  "engines": {
    "node": ">=16.0.0",
    "npm": ">=8.0.0"
  }
}
